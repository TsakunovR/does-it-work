// Jenkins-пайплайн UI-тестов на Selenide (declarative).
//
// Плагины: Pipeline, Allure Jenkins Plugin. Инструменты (Manage Jenkins → Tools):
// JDK с именем `jdk21`, Maven с именем `maven3`, Allure Commandline с именем `allure`.
// Имена в блоке tools ниже должны совпадать с именами установок в Jenkins.
//
// Стенд — только через env WEB_TESTS_* (см. WebConfig): dotenv в Java-ветке нет.
//
// Браузер: на агенте нужен Chrome/Chromium. Надёжнее — контейнер:
//   agent { docker { image 'selenium/standalone-chrome:129.0' args '--shm-size=2g' } }

pipeline {
    agent any

    parameters {
        string(name: 'BASE_URL', defaultValue: '', description: 'URL стенда (пусто — дефолт из WebConfig)')
        string(name: 'API_URL', defaultValue: '', description: 'URL API того же стенда (логин и подготовка данных)')
        choice(name: 'SCOPE', choices: ['regression', 'smoke', 'flaky'],
               description: 'regression — всё кроме карантина (excludedGroups=flaky из pom.xml), smoke — быстрый набор, flaky — прогон карантина')
    }

    options {
        timestamps()
        timeout(time: 45, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    tools {
        jdk 'jdk21'
        maven 'maven3'
        allure 'allure'
    }

    environment {
        // credentials() падает, если такого credential нет в Jenkins:
        // заведите Secret text с этим id или удалите строку, если секрет не нужен.
        WEB_TESTS_SECRET_CODE = credentials('web-tests-secret-code')
        WEB_TESTS_HEADLESS = 'true'
    }

    stages {
        stage('Сборка') {
            steps {
                sh 'mvn -B -ntp test-compile'
            }
        }

        stage('Тесты') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    // Пустая переменная перекрыла бы дефолт WebConfig пустой строкой
                    // (env() лечит только blank, но полагаться на это в CI не стоит).
                    sh '''
                        set -eu
                        if [ -n "${BASE_URL}" ]; then export WEB_TESTS_BASE_URL="${BASE_URL}"; fi
                        if [ -n "${API_URL}" ]; then export WEB_TESTS_API_URL="${API_URL}"; fi
                        case "${SCOPE}" in
                          smoke) mvn -B -ntp test -Dgroups=smoke ;;
                          # Карантин гоняем отдельной сборкой: снимаем исключение из pom.xml
                          # и берём только flaky. Красный результат здесь — не регрессия.
                          flaky) mvn -B -ntp test -DexcludedGroups= -Dgroups=flaky ;;
                          *)     mvn -B -ntp test ;;
                        esac
                    '''
                }
            }
        }
    }

    post {
        always {
            junit testResults: 'target/surefire-reports/*.xml', allowEmptyResults: true
            allure includeProperties: false, results: [[path: 'target/allure-results']]
        }
    }
}
